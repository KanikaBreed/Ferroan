+/*
+ * Copyright (c) 2026 Ferroan contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * New file added by tools/capture/tranquillity-capture.patch.
+ * Applied only to a local Tranquillity build. Not part of upstream.
+ *
+ * When [ClientStack.LindenUDP] ServiceProbe is true, host the existing
+ * Presence and GridUser POST handlers on the region HTTP server. A second
+ * service in this process shares the static caches LLLoginService checks.
+ * The setting is off by default, so an unpatched config does not register them.
+ */
+
+using System.Reflection;
+using Microsoft.Extensions.Logging;
+using Nini.Config;
+using OpenSim.Framework;
+using OpenSim.Framework.Servers;
+using OpenSim.Region.Framework.Interfaces;
+using OpenSim.Region.Framework.Scenes;
+using OpenSim.Server.Handlers.GridUser;
+using OpenSim.Server.Handlers.Presence;
+
+namespace OpenSim.Region.CoreModules.ServiceConnectorsIn.Presence;
+
+public class ServiceProbeConnectorModule : ISharedRegionModule
+{
+    private static readonly ILogger m_log = LoggerProvider.CreateLogger(MethodBase.GetCurrentMethod().DeclaringType);
+    private static bool m_Enabled;
+    private static bool m_Registered;
+
+    private IConfigSource m_Config;
+
+    public void Initialise(IConfigSource config)
+    {
+        m_Config = config;
+        IConfig udp = config.Configs["ClientStack.LindenUDP"];
+        m_Enabled = udp != null && udp.GetBoolean("ServiceProbe", false);
+    }
+
+    public void PostInitialise()
+    {
+    }
+
+    public void Close()
+    {
+    }
+
+    public Type ReplaceableInterface
+    {
+        get { return null; }
+    }
+
+    public string Name
+    {
+        get { return "ServiceProbeConnectorModule"; }
+    }
+
+    public void AddRegion(Scene scene)
+    {
+    }
+
+    public void RemoveRegion(Scene scene)
+    {
+    }
+
+    public void RegionLoaded(Scene scene)
+    {
+        if (!m_Enabled || m_Registered)
+            return;
+
+        m_Registered = true;
+        new PresenceServiceConnector(m_Config, MainServer.Instance.DefaultServer, "PresenceService");
+        new GridUserServiceConnector(m_Config, MainServer.Instance.DefaultServer, "GridUserService");
+        m_log.LogInformation("[SERVICE PROBE]: presence and griduser handlers registered");
+    }
+}
