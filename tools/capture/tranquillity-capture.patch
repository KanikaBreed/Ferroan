+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * New file added by tools/capture/tranquillity-capture.patch.
+ * Applied only to a local Tranquillity build. Not part of upstream.
+ */
+
+using System.Buffers.Binary;
+using Microsoft.Extensions.Logging;
+
+namespace OpenSim.Region.ClientStack.LindenUDP;
+
+/// <summary>
+/// Appends raw UDP datagrams to a FERROCAP1 file. The socket address is not written.
+/// </summary>
+/// <remarks>
+/// Record layout, little-endian: kind u8, time_ms u64, length u32, bytes.
+/// Kind 1 is inbound. Kind 2 is outbound. A datagram longer than 4096 bytes is skipped.
+/// </remarks>
+internal sealed class DatagramCapture : IDisposable
+{
+    private const int MaxDatagram = 4096;
+    private readonly ILogger m_log;
+    private readonly FileStream m_file;
+    private readonly object m_writeLock = new();
+    private bool m_closed;
+
+    private DatagramCapture(FileStream file, ILogger log)
+    {
+        m_file = file;
+        m_log = log;
+    }
+
+    public static DatagramCapture Open(string path, ILogger log)
+    {
+        FileStream file = new(path, FileMode.Create, FileAccess.Write, FileShare.Read);
+        DatagramCapture capture = new(file, log);
+        capture.m_file.Write("FERROCAP1"u8);
+        capture.m_file.Flush();
+        return capture;
+    }
+
+    public void Write(byte kind, byte[] data, int offset, int length)
+    {
+        if (data == null || length <= 0 || length > MaxDatagram)
+            return;
+        if (offset < 0 || offset > data.Length - length)
+            return;
+
+        Span<byte> head = stackalloc byte[13];
+        head[0] = kind;
+        BinaryPrimitives.WriteUInt64LittleEndian(
+            head.Slice(1, 8),
+            (ulong)DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
+        BinaryPrimitives.WriteUInt32LittleEndian(head.Slice(9, 4), (uint)length);
+
+        lock (m_writeLock)
+        {
+            if (m_closed)
+                return;
+            try
+            {
+                m_file.Write(head);
+                m_file.Write(data, offset, length);
+                m_file.Flush();
+            }
+            catch (Exception e)
+            {
+                m_closed = true;
+                m_log.LogWarning("[UDPBASE]: datagram capture write failed: {Type}", e.GetType().Name);
+            }
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (m_writeLock)
+        {
+            if (m_closed)
+                return;
+            m_closed = true;
+            try
+            {
+                m_file.Dispose();
+            }
+            catch (Exception e)
+            {
+                m_log.LogWarning("[UDPBASE]: datagram capture close failed: {Type}", e.GetType().Name);
+            }
+        }
+    }
+}
