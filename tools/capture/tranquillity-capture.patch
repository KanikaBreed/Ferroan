+    /// Open a FERROCAP1 file for raw inbound and outbound datagrams.
+    /// An empty path leaves capture off. A failure is logged by exception type and does not stop the server.
+    /// </summary>
+    public void OpenDatagramCapture(string path)
+    {
+        if (string.IsNullOrEmpty(path) || m_capture != null)
+            return;
+        try
+        {
+            m_capture = DatagramCapture.Open(path, m_log);
+        }
+        catch (Exception e)
+        {
+            m_log.LogWarning("[UDPBASE]: datagram capture did not open: {Type}", e.GetType().Name);
+        }
+    }
+
+    /// <summary>Close the capture file. Safe to call more than once.</summary>
+    public void CloseDatagramCapture()
+    {
+        DatagramCapture capture = m_capture;
+        m_capture = null;
+        capture?.Dispose();
+    }
