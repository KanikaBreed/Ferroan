<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AssemblyName>OarOracle</AssemblyName>
    <RootNamespace>Ferroan.OarOracle</RootNamespace>
    <Description>Pin8 load oar control file and region path.</Description>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="CollectPackageReferences">
    <Error
      Text="Set FerroanRef or FERROAN_REF to the reference checkout. Missing $(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/OpenSim.Region.CoreModules.csproj"
      Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/OpenSim.Region.CoreModules.csproj')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/OpenSim.Region.CoreModules.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
