<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>WalkOracle</AssemblyName>
    <RootNamespace>Ferroan.WalkOracle</RootNamespace>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="CollectPackageReferences">
    <Error
      Text="Set FerroanRef or FERROAN_REF to the reference checkout. Missing $(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.PhysicsModules.BasicPhysics/OpenSim.Region.PhysicsModules.BasicPhysics.csproj"
      Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.PhysicsModules.BasicPhysics/OpenSim.Region.PhysicsModules.BasicPhysics.csproj')" />
  </Target>

  <ItemGroup>
    <!-- SharedBase is the assembly that declares PhysicsScene. A second ProjectReference
         from this tree drops that project's own references during restore, so the
         oracle compiles against the assembly BasicPhysics already builds. -->
    <Reference Include="OpenSim.Region.PhysicsModules.SharedBase">
      <HintPath>$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.PhysicsModules.SharedBase/bin/$(Configuration)/net10.0/OpenSim.Region.PhysicsModules.SharedBase.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse" Version="1.2.9" />
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.PhysicsModules.BasicPhysics/OpenSim.Region.PhysicsModules.BasicPhysics.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
