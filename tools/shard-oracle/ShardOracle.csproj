<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ShardOracle</AssemblyName>
    <RootNamespace>Ferroan.ShardOracle</RootNamespace>
    <Description>Captures the X-SecondLife-Shard refusal on the pinned auth and grid-user handlers.</Description>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="CollectPackageReferences">
    <Error
      Text="Set FerroanRef to a scratch clone from oracle_reference::prepare. Missing $(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj"
      Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework.Servers.HttpServer/OpenSim.Framework.Servers.HttpServer.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Server.Base/OpenSim.Server.Base.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Services.Interfaces/OpenSim.Services.Interfaces.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Server.Handlers/Authentication/AuthenticationServerPostHandler.cs" Link="AuthenticationServerPostHandler.cs" />
    <Compile Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Server.Handlers/GridUser/GridUserServerPostHandler.cs" Link="GridUserServerPostHandler.cs" />
  </ItemGroup>
</Project>
