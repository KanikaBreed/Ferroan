<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GridUserOracle</AssemblyName>
    <RootNamespace>Ferroan.GridUserOracle</RootNamespace>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="CollectPackageReferences">
    <Error
      Text="Set FerroanRef or FERROAN_REF to the reference checkout. Missing $(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Data.SQLite/OpenSim.Data.SQLite.csproj"
      Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Data.SQLite/OpenSim.Data.SQLite.csproj')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Data.SQLite/OpenSim.Data.SQLite.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Data.MySQL/OpenSim.Data.MySQL.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Data.PGSQL/OpenSim.Data.PGSQL.csproj">
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
