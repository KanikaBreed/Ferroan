<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ferroan.OarParcelsOracle</RootNamespace>
    <AssemblyName>OarParcelsOracle</AssemblyName>
    <Description>Resolved parcels from the pinned ArchiveReadRequest.LoadParcels and LandDataSerializer.</Description>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/OpenSim.Region.CoreModules.csproj')"
           Text="Set FerroanRef (or FERROAN_REF) to the reference checkouts root. Missing OpenSim.Region.CoreModules." />
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/World/Archiver/ArchiveReadRequest.cs')"
           Text="Set FerroanRef (or FERROAN_REF) to the reference checkouts root. Missing ArchiveReadRequest.cs." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Services.Interfaces/OpenSim.Services.Interfaces.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.Framework/OpenSim.Region.Framework.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.CoreModules/OpenSim.Region.CoreModules.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <PackageReference Include="UtopiaSkye.OpenMetaverse" Version="1.2.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>
</Project>
