<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ferroan.JoltOracle</RootNamespace>
    <AssemblyName>JoltMatchedOracle</AssemblyName>
    <Description>Matched-native drop at physics rate 45. Reuses the recorder. Does not link ferroan-physics.</Description>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseSharedCompilation>false</UseSharedCompilation>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Tests/JoltPhysicsHarness/Harness.cs')"
           Text="Set FerroanRef (or FERROAN_REF) to the scratch clone from oracle_reference::prepare. Missing Harness.cs." />
  </Target>

  <ItemGroup>
    <Compile Include="MatchedProgram.cs" />
    <Compile Include="MatchedDocument.cs" />
    <Compile Include="../jolt-config-oracle/RecordOracle.cs" Link="RecordOracle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Tests/JoltPhysicsHarness/JoltPhysicsHarness.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false;TreatWarningsAsErrors=false;UseSharedCompilation=false</AdditionalProperties>
    </ProjectReference>
    <Content Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Server.RegionServer/AppData/RegionServerDefaults.ini" Link="RegionServerDefaults.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The pinned harness and region server import this: it puts the deterministic linux-x64 joltc over the package file. -->
  <Import Project="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.PhysicsModules.Jolt.Backend/JoltNative.targets" />
</Project>
