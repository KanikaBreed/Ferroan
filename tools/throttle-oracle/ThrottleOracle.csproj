<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ferroan.ThrottleOracle</RootNamespace>
    <AssemblyName>ThrottleOracle</AssemblyName>
    <Description>Category token-bucket rates from the pinned Tranquillity types.</Description>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj')"
           Text="Set FerroanRef (or FERROAN_REF) to the scratch clone from oracle_reference::prepare. Missing OpenSim.Framework." />
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.ClientStack.LindenUDP/TokenBucket.cs')"
           Text="Set FerroanRef to the scratch clone. Missing TokenBucket.cs." />
    <Error Condition="!Exists('$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.ClientStack.LindenUDP/ThrottleRates.cs')"
           Text="Set FerroanRef to the scratch clone. Missing ThrottleRates.cs." />
  </Target>

  <ItemGroup>
    <PackageReference Include="nini-core" Version="0.9.2.16" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <ProjectReference Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Framework/OpenSim.Framework.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <Compile Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.ClientStack.LindenUDP/TokenBucket.cs" Link="TokenBucket.cs" />
    <Compile Include="$(FerroanRef)/OpenSim-Tranquillity/Source/OpenSim.Region.ClientStack.LindenUDP/ThrottleRates.cs" Link="ThrottleRates.cs" />
  </ItemGroup>
</Project>
