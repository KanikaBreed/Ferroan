<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Ferroan.ReferenceOracle</RootNamespace>
    <AssemblyName>ReferenceOracle</AssemblyName>
    <Description>Deterministic fixtures from the pinned libopenmetaverse checkout.</Description>
    <!-- Compiler warnings only. The referenced OpenMetaverse projects are not ours to clean up. -->
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(HOME)' != ''">$(HOME)/Git/reference</FerroanRef>
    <FerroanRef Condition="'$(FerroanRef)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)/Git/reference</FerroanRef>
  </PropertyGroup>

  <Target Name="RequireFerroanRef" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(FerroanRef)/libopenmetaverse/OpenMetaverse.StructuredData/OpenMetaverse.StructuredData.csproj')"
           Text="Set FerroanRef (or FERROAN_REF) to the reference checkouts root. Missing $(FerroanRef)/libopenmetaverse." />
  </Target>

  <ItemGroup>
    <!-- Compiled from the checkout. Do not copy those sources into this repository. -->
    <ProjectReference Include="$(FerroanRef)/libopenmetaverse/OpenMetaverse.StructuredData/OpenMetaverse.StructuredData.csproj">
      <Private>true</Private>
      <AdditionalProperties>GeneratePackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
