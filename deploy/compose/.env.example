# Copy to deploy/compose/.env. `cargo xtask docker smoke` writes that file
# with generated test passwords. .env is gitignored; do not commit it.
# Smoke sets RUN_UID and RUN_GID to the host user on a rootful daemon, and
# to 0 on a rootless daemon, because container uid 0 is that user.
# Do not reuse a file that has RUN_UID=0 against a rootful daemon.
# There, container uid 0 is the host's root.
RUN_UID=
RUN_GID=
CONFIG_DIR=
DATA_DIR=
LOG_DIR=
ESTATE_PASSWORD=
CHAT_PASSWORD=
