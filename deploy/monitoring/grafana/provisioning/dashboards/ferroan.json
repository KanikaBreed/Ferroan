{
  "uid": "ferroan",
  "title": "Ferroan",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Root agents",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "ferroan_region_root_agents", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Registered",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "ferroan_region_registered", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Frame time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "ferroan_region_frame_seconds", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "UDP resends",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(ferroan_region_udp_resends_total[5m])", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Robust requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (status) (rate(ferroan_robust_http_requests_total[5m]))", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Robust database pool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "ferroan_robust_db_pool_connections", "refId": "A" }]
    }
  ]
}
